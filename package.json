{
  "name": "rurallandlistings",
  "version": "1.0.0",
  "description": "RuralLandListings.com: rural land for sale classifieds and land agent directory",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:demo": "PUBLIC_INCLUDE_DEMO=1 astro build",
    "preview": "npm run build:demo && wrangler dev",
    "check": "astro check && node scripts/check-placeholders.mjs",
    "test": "vitest run",
    "check:wording": "node scripts/check-wording.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "import-csv": "node --experimental-strip-types scripts/import-csv.ts",
    "remove-demo": "node scripts/remove-demo.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:demo": "npm run build:demo && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260928.1",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "private": true,
  "type": "module"
}
