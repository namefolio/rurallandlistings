---
import LandCard from './LandCard.astro';
import type { Land } from '../lib/types';
interface Props { listings: Land[]; eagerFirst?: number; class?: string }
const { listings, eagerFirst = 0, class: cls } = Astro.props;
---
<ul class:list={['land-grid', cls]}>
  {listings.map((l, i) => <LandCard land={l} eager={i < eagerFirst} />)}
</ul>
