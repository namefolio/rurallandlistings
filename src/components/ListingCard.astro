---
import { site } from '../../site.config';
import type { Listing } from '../lib/types';
interface Props { listing: Listing; showCity?: boolean }
const { listing: l, showCity = false } = Astro.props;
const facts = site.cardFacts(l);
const verified = l.effectiveTier === 'verified';
---
<li class:list={['card', { 'is-verified': verified }]}>
  {verified && <span class="badge">Verified</span>}
  <h3><a href={l.url}>{l.name}</a></h3>
  <p class="muted">{l.address.street}{showCity ? `, ${l.address.city}, ${l.address.region}` : ''}</p>
  {facts.length > 0 && <ul>{facts.map((f) => <li>{f}</li>)}</ul>}
</li>
