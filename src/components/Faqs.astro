---
import Icon from './Icon.astro';
import type { Faq } from '../lib/types';
interface Props { faqs: Faq[]; heading?: string; id?: string }
const { faqs, heading = 'Questions', id = 'faqs' } = Astro.props;
---
{faqs.length > 0 && (
  <section aria-labelledby={id}>
    <h2 id={id}>{heading}</h2>
    <div class="faq">
      {faqs.map((f) => (<details><summary>{f.q}<Icon name="down" /></summary><p>{f.a}</p></details>))}
    </div>
  </section>
)}
