---
import Base from '../../layouts/Base.astro';
import AgentList from '../../components/AgentList.astro';
import BestFor from '../../components/BestFor.astro';
import { site } from '../../../site.config';
import { itemList } from '../../lib/jsonld';
import type { Region } from '../../lib/core';

const { region, intro, noindex } = Astro.props as { region: Region; intro: string; noindex: boolean };
const hubUrl = `/${site.hub}/`;
---
<Base
  title={site.titles.region(region.name, region.listings.length)}
  description={site.titles.regionDescription(region.name, region.listings.length, region.cities.length)}
  path={region.url}
  noindex={noindex}
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Land agents', url: hubUrl }, { name: region.name, url: region.url }]}
  jsonld={[itemList(`${site.entity.Many} in ${region.name}`, region.listings)]}
>
  <div class="wrap">
    <h1>Land agents in {region.name}</h1>
    <p class="lead">{intro}</p>
    <ul class="tiles">{region.cities.map((c) => <li><a href={c.url}>{c.name} ({c.listings.length})</a></li>)}</ul>
    <h2>All land agents in {region.name}</h2>
    <AgentList listings={region.listings} />
    <BestFor listings={region.listings} place={region.name} />
  </div>
</Base>
