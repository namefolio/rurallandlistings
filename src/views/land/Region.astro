---
import LandIndex from './LandIndex.astro';
import { site } from '../../../site.config';
import { loadAll, stateTypePages } from '../../lib/data';
import { landItemList } from '../../lib/jsonld';
import type { LandRegion } from '../../lib/land';

const { region, intro, noindex } = Astro.props as { region: LandRegion; intro: string; noindex: boolean };
const c = site.classifieds;
const types = (await stateTypePages()).filter((p) => p.region.slug === region.slug);
const agents = (await loadAll()).regions.find((r) => r.slug === region.slug);
---
<LandIndex
  title={c.titles.region(region.name, region.listings.length)}
  description={c.titles.regionDescription(region.name, region.listings.length, region.counties.length)}
  h1={c.titles.regionH1(region.name)}
  intro={intro}
  path={region.url}
  noindex={noindex}
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Land for sale', url: `/${c.hub}/` }, { name: region.name, url: region.url }]}
  jsonld={[landItemList(`Land for sale in ${region.name}`, region.listings)]}
  listings={region.listings}
  query={`state=${region.slug}`}
  queryName={`Land for sale in ${region.name}`}
  related={[
    { heading: `Land for sale by county in ${region.name}`, links: region.counties.map((k) => ({ label: k.name, url: k.url, n: k.listings.length })) },
    { heading: `Land by type in ${region.name}`, links: types.map((t) => ({ label: t.title, url: t.url, n: t.listings.length })) },
    { heading: `Land agents in ${region.name}`, links: agents ? [{ label: `Land agents in ${region.name}`, url: agents.url, n: agents.listings.length }] : [] },
  ]}
/>
