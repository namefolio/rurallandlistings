---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../../site.config';
import { payLabel, payLink, price } from '../../../lib/copy';
// The Worker rewrites #pay's href to add the business name as a payment reference.
---
<Base title={`Thanks, your Verified request is in | ${site.name}`} description="Your Verified request was sent." path="/add-your-business/thanks-verified/" noindex markdown={false}>
  <h1>Thanks, your Verified request is in</h1>
  <p>We will add or update the listing as Basic now. Verified costs <strong>{price}</strong>.</p>
  <p>Before the Verified label appears, we contact the owner to confirm they run the business, and check the {site.credential.name} with {site.credential.source}. If the check fails, we refund you and the listing stays Basic.</p>
  <div class="btns"><a id="pay" class="btn btn-primary" href={payLink}>{payLabel}</a></div>
  <p><a href="/listing-plans/">How Verified works</a></p>
</Base>
