---
// "Create your agent profile". The Worker fills in ?listing= (update), ?tier= and the Turnstile site key with
// HTMLRewriter; the only script wires the optional profile photo upload.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PhotoUploader from '../../components/PhotoUploader.astro';
import { site } from '../../../site.config';
import { licenseBadge, price } from '../../lib/copy';
import { DAYS } from '../../lib/types';
import { DAY_LABELS } from '../../lib/core';

const states = Object.values(site.regions).filter((r) => r.code).sort((a, b) => a.name.localeCompare(b.name));
const specialties = site.attributes.find((a) => a.key === 'specialties');
const others = site.attributes.filter((a) => a.key !== 'specialties');
---
<Base title={`Create Your Land Agent Profile | ${site.name}`} description={`Land agents and brokers: create a free Basic profile, or get ${licenseBadge} for ${price}. Update an existing profile with the same form.`} path="/add-your-business/" crumbs={[{ name: 'Home', url: '/' }, { name: 'Land agents', url: `/${site.hub}/` }, { name: 'Create your profile', url: '/add-your-business/' }]}>
  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">For land agents and brokers</p>
      <h1>Create your agent profile</h1>
      <p class="lead">A Basic profile is free. Verified ({price}) adds a check of your {site.credential.name} and the {licenseBadge} badge. <a href="/listing-plans/">Compare profiles</a></p>
    </div>
    <p id="update-note" class="notice" hidden><Icon name="info" /><span>You are sending an update for <strong id="update-name">this profile</strong>. Fill in what changes.</span></p>

    <form class="form-card" id="agent-form" method="post" action="/add-your-business/">
      <input type="hidden" name="listing" value="" />
      <input type="hidden" name="photos" value="[]" />
      <input type="hidden" name="uploadSession" value="" />

      <fieldset>
        <legend>Choose a profile</legend>
        <div class="tier-cards">
          <label class="tier-card"><input type="radio" name="tier" value="basic" checked /><strong>Basic (free)<span>Listed in the directory. Anyone can send a new agent or a correction.</span></strong></label>
          <label class="tier-card"><input type="radio" name="tier" value="verified" /><strong>Verified ({price})<span>Agents and their brokerage only. We check your {site.credential.name} first.</span></strong></label>
        </div>
      </fieldset>

      <fieldset>
        <legend>You and your brokerage</legend>
        <div class="field-row">
          <div><label for="f-name">Name on the profile <span class="hint">you or your team</span></label><input id="f-name" name="name" type="text" required maxlength="120" autocomplete="name" /></div>
          <div><label for="f-brokerage">Brokerage</label><input id="f-brokerage" name="brokerage" type="text" maxlength="120" autocomplete="organization" /></div>
        </div>
        <label for="f-type">You are</label>
        <select id="f-type" name="agentType">
          <option value="">Choose one</option>
          {Object.entries(site.agentTypes).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
        <label for="f-desc">About you <span class="hint">(up to 150 words, facts only; shown on Verified profiles)</span></label>
        <textarea id="f-desc" name="description" maxlength="1200" rows="4"></textarea>
      </fieldset>

      <fieldset>
        <legend>Licenses and service area</legend>
        <label for="f-lic">States licensed and license numbers <span class="hint">one per line, like “TX 123456”</span></label>
        <textarea id="f-lic" name="licenses" maxlength="1000" rows="3" placeholder="TX 123456"></textarea>
        <label for="f-counties">Counties you serve <span class="hint">one per line, like “Washington County, TX”</span></label>
        <textarea id="f-counties" name="countiesServed" maxlength="2000" rows="4" placeholder="Washington County, TX"></textarea>
        {specialties?.type === 'multi' && (
          <fieldset class="check-grid">
            <legend>{specialties.label}</legend>
            {Object.entries(specialties.options).map(([k, label]) => <label class="check"><input type="checkbox" name="specialties" value={k} />{label}</label>)}
          </fieldset>
        )}
      </fieldset>

      <fieldset>
        <legend>Office and contact <span class="hint">(published)</span></legend>
        <label for="f-street">Office street address</label>
        <input id="f-street" name="street" type="text" required maxlength="200" autocomplete="address-line1" />
        <div class="field-row">
          <div><label for="f-city">City</label><input id="f-city" name="city" type="text" required maxlength="80" autocomplete="address-level2" /></div>
          <div>
            <label for="f-region">State</label>
            <select id="f-region" name="region" required autocomplete="address-level1">
              <option value="">Choose a state</option>
              {states.map((s) => <option value={s.code}>{s.name}</option>)}
            </select>
          </div>
        </div>
        <label for="f-postal">ZIP code</label>
        <input id="f-postal" name="postalCode" type="text" required maxlength="12" autocomplete="postal-code" inputmode="numeric" />
        <div class="field-row">
          <div><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" maxlength="30" autocomplete="tel" /></div>
          <div><label for="f-pemail">Email for buyers and sellers</label><input id="f-pemail" name="email" type="email" maxlength="200" /></div>
        </div>
        <label for="f-website">Website</label>
        <input id="f-website" name="website" type="url" maxlength="300" placeholder="https://" />
        <label for="f-sameas">Social links <span class="hint">(optional, one per line)</span></label>
        <textarea id="f-sameas" name="sameAs" maxlength="1000" rows="2"></textarea>
      </fieldset>

      <fieldset>
        <legend>Profile photo <span class="hint">(optional)</span></legend>
        <PhotoUploader max={1} checklist={false} label="Add a headshot or logo" help="A clear headshot or your brokerage logo. We resize it automatically. It stays private until your profile is published." />
      </fieldset>

      <details class="more">
        <summary>Office hours and more (optional)</summary>
        <fieldset>
          <legend>Office hours <span class="hint">(like 09:00-17:00, or closed)</span></legend>
          <div class="hours-grid">{DAYS.map((d) => (<div><label for={`f-h-${d}`}>{DAY_LABELS[d]}</label><input id={`f-h-${d}`} name={`hours_${d}`} type="text" maxlength="40" /></div>))}</div>
        </fieldset>
        {others.map((a) =>
          a.type === 'multi' ? (
            <fieldset class="check-grid">
              <legend>{a.label}</legend>
              {Object.entries(a.options).map(([k, label]) => <label class="check"><input type="checkbox" name={a.key} value={k} />{label}</label>)}
            </fieldset>
          ) : a.type === 'bool' ? (
            <><label for={`f-${a.key}`}>{a.label}</label>
            <select id={`f-${a.key}`} name={a.key}><option value="">Not sure</option><option value="yes">Yes</option><option value="no">No</option></select></>
          ) : (
            <><label for={`f-${a.key}`}>{a.label}</label><input id={`f-${a.key}`} name={a.key} type="number" min="0" max={a.max ?? 1000000} inputmode="numeric" /></>
          ),
        )}
      </details>

      <fieldset class="form-private">
        <legend>About you <span class="hint">(private, never published)</span></legend>
        <div class="field-row">
          <div><label for="f-sname">Your name</label><input id="f-sname" name="submitterName" type="text" required maxlength="100" autocomplete="name" /></div>
          <div><label for="f-semail">Your email</label><input id="f-semail" name="submitterEmail" type="email" required maxlength="200" autocomplete="email" /></div>
        </div>
        <label for="f-rel">Your relationship to this profile</label>
        <select id="f-rel" name="relationship" required>
          <option value="owner">I am the agent</option>
          <option value="staff">I work at their brokerage</option>
          <option value="customer">Someone else (a correction)</option>
        </select>
        <label class="check"><input type="checkbox" name="consent" value="yes" required />I agree that the profile details I send may be published, and that you may email me about this profile.</label>
      </fieldset>

      <div class="hp" aria-hidden="true">
        <label for="f-hp">Leave this empty</label>
        <input id="f-hp" name="fax_number" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="cf-turnstile" data-sitekey=""></div>
      <p class="help">Corrections from someone other than the agent are always sent as Basic. We review every profile before it goes live.</p>
      <div class="btns"><button class="btn btn-primary btn-lg" type="submit" data-submit>Send profile</button></div>
    </form>
  </div>
  <script>import '../../scripts/agent-form';</script>
</Base>
