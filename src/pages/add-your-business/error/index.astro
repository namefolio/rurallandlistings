---
import Prose from '../../../layouts/Prose.astro';
import { PLACEHOLDERS, site } from '../../../../site.config';
const email = PLACEHOLDERS.submissionsEmail;
---
<Prose title={`Your profile was not sent | ${site.name}`} description="The form could not be sent." path="/add-your-business/error/" h1="Sorry, that did not send" noindex crumbs={false}>
  <p>Something went wrong: a required field or the security check was missing, or the photo upload had expired. Nothing was stored.</p>
  <p><a href="/add-your-business/">Try the form again</a>, or email the details to <a href={`mailto:${email}`}>{email}</a>.</p>
</Prose>
