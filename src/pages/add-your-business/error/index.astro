---
import Base from '../../../layouts/Base.astro';
import { PLACEHOLDERS, site } from '../../../../site.config';
const email = PLACEHOLDERS.submissionsEmail;
---
<Base title={`Your listing was not sent | ${site.name}`} description="The form could not be sent." path="/add-your-business/error/" noindex markdown={false}>
  <h1>Sorry, that did not send</h1>
  <p>Something went wrong, or a required field or the spam check was missing. Nothing was stored.</p>
  <p><a href="/add-your-business/">Try the form again</a>, or email the details to <a href={`mailto:${email}`}>{email}</a>.</p>
</Base>
