---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
---
<Base title={`Page not found | ${site.name}`} description="This page does not exist." path="/404/" noindex markdown={false}>
  <h1>Page not found</h1>
  <p>This page does not exist, or the listing was removed.</p>
  <p><a href="/">Go to the home page</a> or <a href={`/${site.hub}/`}>browse {site.entity.many} by {site.regionNoun}</a>.</p>
</Base>
