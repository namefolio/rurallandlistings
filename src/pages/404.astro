---
import Base from '../layouts/Base.astro';
import { site } from '../../site.config';
---
<Base title={`Page not found | ${site.name}`} description="This page does not exist." path="/404/" noindex markdown={false}>
  <h1>Page not found</h1>
  <p>This page does not exist, or the listing ended or was removed. Land ads come down after their paid period.</p>
  <p><a href="/">Go to the home page</a>, <a href={`/${site.classifieds.hub}/`}>browse land for sale</a> or <a href={`/${site.hub}/`}>find a {site.entity.one}</a>.</p>
</Base>
