---
import Base from '../../layouts/Base.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import ValueProp from '../../components/ValueProp.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../../site.config';
import { licenseBadge, notChecked, price } from '../../lib/copy';
---
<Base title={`How It Works: Buying and Selling Land on ${site.name}`} description="How buyers find land and contact sellers directly, how sellers list land for $49, and what RuralLandListings does and does not check." path="/how-it-works/" markdown={false} crumbs={[{ name: 'Home', url: '/' }, { name: 'How it works', url: '/how-it-works/' }]}>
  <div class="wrap">
    <div class="page-head">
      <h1>How it works</h1>
      <p class="lead">{site.name} is a marketplace for rural land. Sellers pay a flat fee to list; buyers search for free and contact sellers directly. We are not a real estate brokerage and we do not represent either side.</p>
    </div>
    <HowItWorks level="h2" />
  </div>
  <section class="section">
    <div class="wrap cols-2">
      <div>
        <h2>What we check, and what we don’t</h2>
        <p>We review every land listing before it goes live, to make sure it is complete, describes land for sale, and is not misleading on its face. We do not inspect land or check public records. Listing information is provided by the seller and is not independently verified, including:</p>
        <ul class="checks two">{notChecked.map((x) => <li><Icon name="info" />{x}</li>)}</ul>
        <p>Buyers should independently verify property information and conduct appropriate due diligence before purchasing. <a href="/listing-disclaimer/">Read the listing disclaimer</a>.</p>
      </div>
      <div>
        <h2>Land agents and {licenseBadge}</h2>
        <p>Any land agent can create a free Basic profile. Agents who pay for Verified ({price}) get the {licenseBadge} badge after we look up their real estate license with the state commission’s public lookup and confirm the details with them. Each Verified profile shows which states were checked and when.</p>
        <p>{licenseBadge} confirms a license check. It is not a rating, review or endorsement of the agent’s work.</p>
        <p><a href="/listing-plans/">Agent profiles and pricing</a></p>
      </div>
    </div>
  </section>
  <section class="section band-white"><div class="wrap"><ValueProp /></div></section>
</Base>
