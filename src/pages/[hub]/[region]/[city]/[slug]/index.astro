---
import AgentListing from '../../../../../views/agents/Listing.astro';
import LandListing from '../../../../../views/land/Listing.astro';
import { landPaths, listingPaths } from '../../../../../lib/pages';

export const getStaticPaths = async () => [...(await listingPaths()), ...(await landPaths())];
const props = Astro.props;
---
{props.kind === 'land' ? <LandListing {...props} /> : <AgentListing {...props} />}
