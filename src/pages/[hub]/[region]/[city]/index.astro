---
import AgentCity from '../../../../views/agents/City.astro';
import LandCounty from '../../../../views/land/County.astro';
import { cityPaths, countyPaths } from '../../../../lib/pages';

export const getStaticPaths = async () => [...(await cityPaths()), ...(await countyPaths())];
const props = Astro.props;
---
{props.kind === 'land' ? <LandCounty {...props} /> : <AgentCity {...props} />}
