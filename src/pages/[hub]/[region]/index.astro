---
import AgentRegion from '../../../views/agents/Region.astro';
import LandRegion from '../../../views/land/Region.astro';
import { landRegionPaths, regionPaths } from '../../../lib/pages';

export const getStaticPaths = async () => [...(await regionPaths()), ...(await landRegionPaths())];
const props = Astro.props;
---
{props.kind === 'land' ? <LandRegion {...props} /> : <AgentRegion {...props} />}
