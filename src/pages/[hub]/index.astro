---
// Hub pages for both listing kinds: the directory (agents) and the classifieds (land).
import AgentHub from '../../views/agents/Hub.astro';
import LandHub from '../../views/land/Hub.astro';
import { site } from '../../../site.config';

export const getStaticPaths = () => [
  { params: { hub: site.hub }, props: { kind: 'agents' } },
  { params: { hub: site.classifieds.hub }, props: { kind: 'land' } },
];
const { kind } = Astro.props;
---
{kind === 'land' ? <LandHub /> : <AgentHub />}
