---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../../site.config';
import { classifiedPayLabel, classifiedPayLink, classifiedPrice } from '../../../lib/copy';
// The Worker rewrites #pay's href to add the listing title as a payment reference.
---
<Base title={`Thanks, now pay to publish your land listing | ${site.name}`} description="Your land listing was sent." path="/sell-your-land/thanks/" noindex markdown={false}>
  <h1>Thanks, your land listing is in</h1>
  <p>It goes live once we have your payment of <strong>{classifiedPrice}</strong> and have reviewed the ad, usually within a couple of days. It then runs for {site.classifieds.days} days.</p>
  <div class="btns"><a id="pay" class="btn btn-primary" href={classifiedPayLink}>{classifiedPayLabel}</a></div>
  <p>We email you when it is live. <a href="/sell-your-land/">How land listings work</a></p>
</Base>
