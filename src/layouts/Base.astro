---
import '../theme.css';
import '../styles/base.css';
import { PLACEHOLDERS, site } from '../../site.config';
import { footerLine } from '../lib/copy';

interface Props {
  title: string;
  description: string;
  /** Path with trailing slash, e.g. "/tattoo-shops/texas/". */
  path: string;
  noindex?: boolean;
  jsonld?: object[];
  crumbs?: { name: string; url: string }[];
  /** Markdown twin; defaults to {path}index.md. Set false for pages without one. */
  markdown?: string | false;
  banner?: boolean;
}
const { title, description, path, noindex = false, jsonld = [], crumbs, markdown, banner = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const md = markdown === false ? undefined : (markdown ?? `${path}index.md`);
const ld = [...jsonld];
if (crumbs?.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, site.url).href })),
  });
}
const forSale = PLACEHOLDERS.forSaleContact;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="preload" href="/fonts/atkinson-hyperlegible-next.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {md && <link rel="alternate" type="text/markdown" href={md} title="Markdown version" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta name="theme-color" content="#16130f" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {banner && (
      <div class="banner">This domain is for sale. <a href={forSale}>Contact the owner</a></div>
    )}
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul>
            <li><a href={`/${site.hub}/`}>Browse by {site.regionNoun}</a></li>
            <li><a href="/add-your-business/">Add a listing</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      {crumbs?.length && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (i === crumbs.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={c.url}>{c.name}</a></li>))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <ul class="footer-links">
          <li><a href="/about/">About and sources</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/add-your-business/">Add or update a listing</a></li>
          <li><a href="/listing-plans/">Listing plans</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
        </ul>
        <p class="muted">{footerLine}</p>
      </div>
    </footer>
  </body>
</html>
